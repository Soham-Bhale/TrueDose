{
  "name": "lifeledger-platform",
  "version": "2.0.0",
  "description": "LifeLedger: Decentralized Organ Procurement, Chain-of-Custody & Cold Ischemia Verification System",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\" -n \"SERVER,CLIENT\" -c \"blue,green\"",
    "dev:full": "concurrently \"npm run hardhat:node\" \"npm run server\" \"npm run client\" -n \"NODE,SERVER,CLIENT\" -c \"yellow,blue,green\"",
    "install:all": "npm install --prefix contracts && npm install --prefix server && npm install --prefix client",
    "compile:contracts": "npm run compile --prefix contracts",
    "deploy:contracts": "npm run deploy:local --prefix contracts",
    "hardhat:node": "npx --prefix contracts hardhat node",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js",
    "test:contracts": "npm test --prefix contracts",
    "test:api": "node server/test/api.test.js"
  },
  "keywords": [
    "blockchain",
    "organ-donation",
    "transplant",
    "chain-of-custody",
    "cold-ischemia",
    "anti-trafficking",
    "smart-contracts",
    "solidity",
    "ethereum",
    "react"
  ],
  "author": "LifeLedger Consortium",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
